        "dvQueryString": "dv.pages('\"01 - Campaigns/' + current.file.path.split(\"/\")[1] + '\"')\n  .where(p => [\"location\", \"establishment\"].includes(String(p.type).toLowerCase())\n    && p.file.path !== current.file.path)",
