      "colorClass": "file",
      "options": {
        "dvQueryString": "dv.pages('\"01 - Campaigns/' + current.file.path.split(\"/\")[1] + '\"')\n  .where(p => [\"player\", \"npc\", \"faction\"].includes(String(p.type).toLowerCase())\n    && p.file.path !== current.file.path)",
        "customRendering": "page.name || page.file.name",
        "customSorting": "(() => { const mc = globalThis.app?.metadataCache; const rank = (f) => ({ player: 0, npc: 1, faction: 2 })[String(mc?.getFileCache(f)?.frontmatter?.type || \"\").toLowerCase()] ?? 3; return rank(a) - rank(b) || a.basename.localeCompare(b.basename); })()"
